set_option maxRecDepth 20000

/-! ## Two `Vec<u8>` facts -/

theorem clone_u8 : ∀ x : Std.U8, core.clone.CloneU8.clone x = ok x := fun _ => rfl

/-- `Vec::extend_from_slice` at `u8` appends. -/
theorem extend_u8_val {v w : alloc.vec.Vec Std.U8} {s : Slice Std.U8}
    (h : alloc.vec.Vec.extend_from_slice core.clone.CloneU8 v s = ok w) :
    w.val = v.val ++ s.val := by
  obtain ⟨s', hs', hss⟩ := WP.spec_imp_exists
    (Slice.clone_spec (clone := core.clone.CloneU8.clone) (s := s) (fun x _ => clone_u8 x))
  unfold alloc.vec.Vec.extend_from_slice at h
  split at h
  · split at h
    · rename_i s'' hm
      simp only [Result.ok.injEq] at h
      subst h
      have : Slice.clone core.clone.CloneU8.clone s = ok s'' := by simpa using hm
      rw [hs'] at this
      cases Result.ok_injective this
      simp [hss]
    · simp at h
    · simp at h
  · simp at h

theorem vec_with_capacity_val {α : Type} (c : Std.Usize) :
    (alloc.vec.Vec.with_capacity α c).val = [] := rfl

/-- One `let s ← lift (Array.to_slice P); let out' ← push_chunk out s; k out'`
step of the port's `prelude_text`, read backwards off an accepting run. -/
theorem push_chunk_step {n : Std.Usize} {P : Std.Array Std.U8 n}
    {out : alloc.vec.Vec Std.U8} {k : alloc.vec.Vec Std.U8 → Result (alloc.vec.Vec Std.U8)}
    {v : alloc.vec.Vec Std.U8}
    (h : (do
        let s ← lift (Std.Array.to_slice P)
        let out' ← frontend.prelude_text.push_chunk out s
        k out') = ok v) :
    ∃ out', out'.val = out.val ++ P.val ∧ k out' = ok v := by
  simp only [lift, bind_tc_ok] at h
  obtain ⟨o, ho, h⟩ := ConRon.Refine.bind_eq_ok_iff.mp h
  rw [frontend.prelude_text.push_chunk] at ho
  exact ⟨o, by rw [extend_u8_val ho]; simp [Std.Array.to_slice], h⟩

/-- The last step: no continuation. -/
theorem push_chunk_last {n : Std.Usize} {P : Std.Array Std.U8 n}
    {out : alloc.vec.Vec Std.U8} {v : alloc.vec.Vec Std.U8}
    (h : (do
        let s ← lift (Std.Array.to_slice P)
        frontend.prelude_text.push_chunk out s) = ok v) :
    v.val = out.val ++ P.val := by
  simp only [lift, bind_tc_ok] at h
  rw [frontend.prelude_text.push_chunk] at h
  rw [extend_u8_val h]; simp [Std.Array.to_slice]


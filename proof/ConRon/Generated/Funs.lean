                  ok (core.result.Result.Ok
                    {
                      pr,
                      ad,
                      su,
                      mu,
                      po,
                      be,
                      bl,
                      di,
                      mo,
                      gc,
                      la,
                      lo,
                      xo,
                      sl,
                      sr
                    }, st8)
                | core.result.Result.Err e =>
                  ok (core.result.Result.Err e, st8)
              | core.result.Result.Err e => ok (core.result.Result.Err e, st7)
            | core.result.Result.Err e => ok (core.result.Result.Err e, st6)

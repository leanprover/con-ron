def arena.basis.quot_preds_ok
  (pers : arena.store.PersTier) (st : arena.monad.AState)
  (fe : arena.env.IFEnv) (k : kernel.env.QuotKind) :
  Result (core.result.Result Bool kernel.core_types.CheckError)
  := do
  let r ← arena.pins.pin_eq st
  match r with
  | core.result.Result.Ok en =>
    let r1 ← arena.pins.pin_quot st
    match r1 with
    | core.result.Result.Ok qn =>
      let r2 ← arena.pins.pin_quot_mk st
      match r2 with
      | core.result.Result.Ok mn =>
        let o ← arena.env.ifenv_find pers fe en
        let has_eq := core.option.Option.is_some o
        let o1 ← arena.env.ifenv_find pers fe qn
        let has_q := core.option.Option.is_some o1
        let o2 ← arena.env.ifenv_find pers fe mn
        let has_m := core.option.Option.is_some o2
        match k with
        | kernel.env.QuotKind.Type => ok (core.result.Result.Ok has_eq)
        | kernel.env.QuotKind.Ctor => ok (core.result.Result.Ok has_q)
        | kernel.env.QuotKind.Lift =>
          if has_eq
          then
            if has_q
            then ok (core.result.Result.Ok has_m)
            else ok (core.result.Result.Ok false)
          else ok (core.result.Result.Ok false)
        | kernel.env.QuotKind.Ind =>
          if has_q
          then ok (core.result.Result.Ok has_m)
          else ok (core.result.Result.Ok false)
        | kernel.env.QuotKind.Sound =>
          if has_eq
          then
            if has_q
            then ok (core.result.Result.Ok has_m)
            else ok (core.result.Result.Ok false)
          else ok (core.result.Result.Ok false)
      | core.result.Result.Err e => ok (core.result.Result.Err e)
    | core.result.Result.Err e => ok (core.result.Result.Err e)
  | core.result.Result.Err e => ok (core.result.Result.Err e)


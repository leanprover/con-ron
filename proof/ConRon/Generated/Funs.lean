        | core.result.Result.Err e => ok (core.result.Result.Err e, ar1)
    else ok (core.result.Result.Err frontend.olean.spec.RdErr.Bad, ar)
  else ok (core.result.Result.Err frontend.olean.spec.RdErr.Bad, ar)


def frontend.pace.pace_due_count
  (p : frontend.pace.Pace) (k : Std.U64) (total : Std.U64) : Result Bool := do
  match p with
  | frontend.pace.Pace.Off => ok false
  | frontend.pace.Pace.Every n =>
    if n > 0#u64
    then let i ← k % n
         ok (i = 0#u64)
    else ok false
  | frontend.pace.Pace.Percent q =>
    let d ← frontend.pace.sat_mul q total
    let km1 ← if k > 0#u64
                then k - 1#u64
                else ok 0#u64
    if d > 0#u64
    then
      let i ← frontend.pace.sat_mul k 100#u64
      let i1 ← i / d
      let i2 ← frontend.pace.sat_mul km1 100#u64
      let i3 ← i2 / d
      ok (i1 != i3)
    else ok false
  | frontend.pace.Pace.Seconds _ => ok false


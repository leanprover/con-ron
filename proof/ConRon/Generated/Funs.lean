  match r with
  | core.result.Result.Ok di =>
    let (r1, st2) ← arena.core.nat_mod_name st1
    match r1 with
    | core.result.Result.Ok mo =>
      let (r2, st3) ← arena.core.nat_gcd_name st2
      match r2 with
      | core.result.Result.Ok gc =>

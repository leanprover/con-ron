def kernel.inductives.modeled.check_eta_thm
  (mode : kernel.env.CheckMode) (fe2 : kernel.fenv.FEnv) (t : kernel.name.Name)
  (ctor_name : kernel.name.Name) (lps : alloc.vec.Vec kernel.name.Name)
  (n_p : Std.U64) (n_f : Std.U64) :
  Result Bool
  := do

def kernel.pins_decode.run_records
  (t : Slice Std.U8) (i : Std.Usize) (tb : kernel.pins_decode.Tables) :
  Result (core.result.Result (alloc.vec.Vec kernel.nat_op_pins.NatOpPinSet)
    kernel.core_types.CheckError)

    kernel.inductives.modeled.check_unit_thm mode fe2 cv_t.name
      cv_t.level_params n_p
  let pw ← kernel.core_k.pi_result_z cv_t.ty
  ok
    {
      eta,
      eta_ctor := n,
      eta_params := n_p,
      eta_fields := n_f,
      unitlike := b1,
      unit_params := n_p,
      rule_k,
      sort_z := pw
    }


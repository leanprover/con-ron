    Visibility: public -/
def arena.store.e_view_has_scratch_child
  (v : arena.store.ENodeView) : Result Bool := do
  match v with
  | arena.store.ENodeView.BVar _ => ok false
  | arena.store.ENodeView.FVar _ ty =>
    let b ← arena.handle.EIdx.is_persistent ty
    ok (¬ b)
  | arena.store.ENodeView.Sort u =>
    let b ← arena.handle.LIdx.is_persistent u
    ok (¬ b)
  | arena.store.ENodeView.Const n us =>
    let b ← arena.handle.NIdx.is_persistent n
    if b
    then let b1 ← arena.handle.LsIdx.is_persistent us
         ok (¬ b1)
    else ok true
  | arena.store.ENodeView.App f a =>
    let b ← arena.handle.EIdx.is_persistent f
    if b
    then let b1 ← arena.handle.EIdx.is_persistent a
         ok (¬ b1)
    else ok true
  | arena.store.ENodeView.Lam ty b _ =>
    let b1 ← arena.handle.EIdx.is_persistent ty
    if b1
    then let b2 ← arena.handle.EIdx.is_persistent b
         ok (¬ b2)
    else ok true
  | arena.store.ENodeView.ForallE ty b _ =>
    let b1 ← arena.handle.EIdx.is_persistent ty
    if b1
    then let b2 ← arena.handle.EIdx.is_persistent b
         ok (¬ b2)
    else ok true
  | arena.store.ENodeView.LetE ty val b =>
    let b1 ← arena.handle.EIdx.is_persistent ty
    if b1
    then
      let b2 ← arena.handle.EIdx.is_persistent val
      if b2
      then let b3 ← arena.handle.EIdx.is_persistent b
           ok (¬ b3)
      else ok true
    else ok true
  | arena.store.ENodeView.Lit _ => ok false
  | arena.store.ENodeView.Proj n _ e =>
    let b ← arena.handle.NIdx.is_persistent n
    if b
    then let b1 ← arena.handle.EIdx.is_persistent e
         ok (¬ b1)
    else ok true


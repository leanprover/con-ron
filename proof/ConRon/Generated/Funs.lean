  if k = 101#u64
  then let i1 ← i + 1#usize
       kernel.pins_decode.run_footer t i1 tb
  else
    let i1 ← i + 1#usize
    let r ← kernel.pins_decode.after_space t i1
    match r with
    | core.result.Result.Ok j =>
      let step ←
        if k = 78#u64
        then kernel.pins_decode.record_name t j tb
        else
          if k = 76#u64
          then kernel.pins_decode.record_level t j tb
          else
            if k = 87#u64
            then kernel.pins_decode.record_pw t j tb
            else
              if k = 69#u64

  then
    let o ← arena.monad.view_app pers st e
    match o with
    | none =>
      let r ← arena.monad.fail_dangling_e (Option arena.handle.EIdx)
      ok (r, st)
    | some p =>
      let (f, b) := p
      let r ← arena.monad.view pers st f

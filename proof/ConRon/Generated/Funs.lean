      match r1 with
      | core.result.Result.Ok ci =>
        let o ←
          alloc.vec.Vec.push (alloc.vec.Vec.new arena.env.IConstantInfo) ci
        ok (core.result.Result.Ok o, st1)
      | core.result.Result.Err e => ok (core.result.Result.Err e, st1)
    else
      let r1 ← arena.pins.pin_sorry_ax st
      match r1 with
      | core.result.Result.Ok sa =>
        let b1 ←
          arena.handle.NIdx.Insts.Con_ron_coreRonHashmapEq2.eq2 cv.name sa
        if b1
        then
          ok (core.result.Result.Ok (alloc.vec.Vec.new
            arena.env.IConstantInfo), st)
        else
          let iv ← arena.env.i_constant_val_dup cv
          let o ←
            alloc.vec.Vec.push (alloc.vec.Vec.new arena.env.IConstantInfo)
              (arena.env.IConstantInfo.AxiomInfo iv)
          ok (core.result.Result.Ok o, st)
      | core.result.Result.Err e => ok (core.result.Result.Err e, st)
  | core.result.Result.Err e => ok (core.result.Result.Err e, st)

/-- [con_ron_core::arena::install::decl_constants]:
    Source: 'crates/con-ron-core/src/arena/install.rs', lines 367:0-399:1

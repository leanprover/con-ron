/-- [con_ron_core::arena::inductives::positivity::family_key_check]:
    Source: 'crates/con-ron-core/src/arena/inductives/positivity.rs', lines 737:0-766:1
    Visibility: public -/
def arena.inductives.positivity.family_key_check
  (pers : arena.store.PersTier) (st : arena.monad.AState)
  (mode : kernel.env.CheckMode) (fe : arena.env.IFEnv) (d : Std.U64)
  (c : arena.handle.NIdx) (us : arena.handle.LsIdx)
  (ds : alloc.vec.Vec arena.handle.EIdx) :
  Result ((core.result.Result Unit kernel.core_types.CheckError) ×
    arena.monad.AState)
  := do
  let o ← arena.env.ifenv_find pers fe c
  match o with
  | none =>
    let s ← lift (Array.to_slice arena.inductives.positivity.M_KEY_NO_FAMILY)
    let v ← kernel.core_types.code_points s
    let ce ← kernel.core_types.invalid v
    let r ← arena.monad.fail Unit ce
    ok (r, st)
  | some ii =>
    match ii with
    | arena.env.IConstantInfo.AxiomInfo _ =>
      let s ←
        lift (Array.to_slice arena.inductives.positivity.M_KEY_NO_FAMILY)
      let v ← kernel.core_types.code_points s
      let ce ← kernel.core_types.invalid v
      let r ← arena.monad.fail Unit ce
      ok (r, st)
    | arena.env.IConstantInfo.DefnInfo _ _ _ =>
      let s ←
        lift (Array.to_slice arena.inductives.positivity.M_KEY_NO_FAMILY)
      let v ← kernel.core_types.code_points s
      let ce ← kernel.core_types.invalid v
      let r ← arena.monad.fail Unit ce
      ok (r, st)
    | arena.env.IConstantInfo.ThmInfo _ =>
      let s ←
        lift (Array.to_slice arena.inductives.positivity.M_KEY_NO_FAMILY)
      let v ← kernel.core_types.code_points s
      let ce ← kernel.core_types.invalid v
      let r ← arena.monad.fail Unit ce
      ok (r, st)
    | arena.env.IConstantInfo.IndInfo cv caps =>
      let o1 ← arena.monad.view_ls_len pers st us
      match o1 with
      | none => let r ← arena.monad.fail_dangling_ls Unit
                ok (r, st)
      | some nl =>
        let i := alloc.vec.Vec.len cv.level_params
        if nl != i
        then
          let s ←
            lift (Array.to_slice arena.inductives.positivity.M_KEY_LEVELS)
          let v ← kernel.core_types.code_points s
          let ce ← kernel.core_types.invalid v
          let r ← arena.monad.fail Unit ce
          ok (r, st)
        else
          let (r, st1) ←
            arena.inductives.positivity.family_telescope pers st mode fe cv
              caps
          match r with
          | core.result.Result.Ok ty =>
            let (r1, st2) ←
              arena.expr_ops.inst_lp_fast pers st1 arena.core.CORE_WALK_FUEL
                cv.level_params us ty
            match r1 with
            | core.result.Result.Ok t =>
              arena.inductives.positivity.check_spine_at pers st2 mode fe d t
                ds 0#usize
            | core.result.Result.Err e => ok (core.result.Result.Err e, st2)
          | core.result.Result.Err e => ok (core.result.Result.Err e, st1)
    | arena.env.IConstantInfo.CtorInfo _ _ _ _ =>
      let s ←
        lift (Array.to_slice arena.inductives.positivity.M_KEY_NO_FAMILY)
      let v ← kernel.core_types.code_points s
      let ce ← kernel.core_types.invalid v
      let r ← arena.monad.fail Unit ce
      ok (r, st)
    | arena.env.IConstantInfo.RecInfo _ _ _ _ _ =>
      let s ←
        lift (Array.to_slice arena.inductives.positivity.M_KEY_NO_FAMILY)
      let v ← kernel.core_types.code_points s
      let ce ← kernel.core_types.invalid v
      let r ← arena.monad.fail Unit ce
      ok (r, st)

